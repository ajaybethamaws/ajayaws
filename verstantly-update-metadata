import { S3Client, CopyObjectCommand, DeleteObjectCommand } from "@aws-sdk/client-s3";
import { DynamoDBClient } from "@aws-sdk/client-dynamodb";
import { DynamoDBDocumentClient, UpdateCommand, GetCommand } from "@aws-sdk/lib-dynamodb";
import { SNSClient, PublishCommand } from "@aws-sdk/client-sns";

// Initialize AWS Clients
const s3Client = new S3Client({});
const ddbClient = new DynamoDBClient({});
const docClient = DynamoDBDocumentClient.from(ddbClient);
const snsClient = new SNSClient({});

// Environment variables configuration
const BUCKET_NAME = process.env.BUCKET_NAME; 
const TABLE_NAME = process.env.TABLE_NAME || "verstantly-verse-images";
const TOPIC_ARN = process.env.SNS_TOPIC_ARN;

export const handler = async (event) => {
    // Determine incoming HTTP Method safely across API Gateway payload v1 & v2 formats
    const httpMethod = event.httpMethod || event.requestContext?.http?.method;

    // 1. Handle API Gateway CORS preflight requests (OPTIONS method)
    if (httpMethod === "OPTIONS") {
        return buildResponse(200, {}, event);
    }

    try {
        // 2. Safely parse the incoming JSON body (including bible_version)
        const body = JSON.parse(event.body || "{}");
        const { image_id, verse_text, reference, requested_filename, bible_version } = body;

        // Validation check for mandatory payload items
        if (!image_id || !verse_text || !reference || !requested_filename) {
            return buildResponse(400, { 
                success: false, 
                message: "Missing required fields: image_id, verse_text, reference, and requested_filename are all required." 
            }, event);
        }

        if (!BUCKET_NAME) {
            console.error("Configuration Error: BUCKET_NAME environment variable is not defined.");
            return buildResponse(500, { success: false, message: "Server configuration missing bucket context." }, event);
        }

        // 3. Clean up the incoming filename
        const sanitizedFilename = requested_filename
            .toLowerCase()
            .trim()
            .replace(/\s+/g, "-")           // Turn spaces into single hyphens
            .replace(/[^a-z0-9.\-_]/g, ""); // Strip out invalid characters

        const newS3Key = `images/${sanitizedFilename}`;

        // 4. Retrieve existing state from DynamoDB
        const currentItem = await docClient.send(new GetCommand({
            TableName: TABLE_NAME,
            Key: { image_id }
        }));

        if (!currentItem.Item) {
            return buildResponse(404, { success: false, message: `No image record found matching ID: ${image_id}` }, event);
        }

        const oldS3Key = currentItem.Item.s3_key;
        let finalS3Key = oldS3Key;
        let finalFilename = currentItem.Item.current_filename;

        // Track changes explicitly for S3 rename
        let s3Renamed = false;
        if (oldS3Key !== newS3Key) {
            console.log(`Executing S3 object transition from [${oldS3Key}] to [${newS3Key}]`);

            await s3Client.send(new CopyObjectCommand({
                Bucket: BUCKET_NAME,
                CopySource: encodeURIComponent(`${BUCKET_NAME}/${oldS3Key}`),
                Key: newS3Key
            }));

            await s3Client.send(new DeleteObjectCommand({
                Bucket: BUCKET_NAME,
                Key: oldS3Key
            }));

            finalS3Key = newS3Key;
            finalFilename = sanitizedFilename;
            s3Renamed = true;
        }

        // 5. Update DynamoDB Item (Persisting bible_version alongside other fields)
        const timestamp = new Date().toISOString();
        const updateResult = await docClient.send(new UpdateCommand({
            TableName: TABLE_NAME,
            Key: { image_id },
            UpdateExpression: "SET current_filename = :fn, s3_key = :key, verse_text = :vt, reference = :ref, bible_version = :bv, updated_at = :uat",
            ExpressionAttributeValues: {
                ":fn": finalFilename,
                ":key": finalS3Key,
                ":vt": verse_text,
                ":ref": reference,
                ":bv": bible_version || "",
                ":uat": timestamp
            },
            ReturnValues: "ALL_NEW"
        }));

        // 6. SNS Notification
        if (TOPIC_ARN) {
            try {
                await snsClient.send(new PublishCommand({
                    TopicArn: TOPIC_ARN,
                    Subject: `⚠️ Verse Metadata Modified: ID ${image_id}`,
                    Message: `An asset's metadata or storage details have been updated via the management console.\n\n` +
                             `• Image ID: ${image_id}\n` +
                             `• Reference: ${reference}\n` +
                             `• Bible Version: ${bible_version || "None"}\n` +
                             `• Verse Text: "${verse_text}"\n` +
                             `• S3 Storage Key: ${finalS3Key}\n` +
                             `• File Renamed: ${s3Renamed ? `Yes (Old path: ${oldS3Key})` : "No"}\n` +
                             `• Modification Timestamp: ${timestamp}\n\n` +
                             `Infrastructure Alert System - Verstantly`
                }));
            } catch (snsErr) {
                return buildResponse(500, {
                    success: false,
                    message: "Database updated, but SNS failed.",
                    error: snsErr.message,
                    code: snsErr.code || snsErr.__type
                }, event);
            }
        }

        return buildResponse(200, {
            success: true,
            message: "Metadata and filename successfully processed.",
            data: updateResult.Attributes
        }, event);

    } catch (error) {
        console.error("Execution Exception Caught:", error);
        return buildResponse(500, { 
            success: false, 
            message: "An internal server error occurred while updating the asset details.", 
            error: error.message 
        }, event);
    }
};

/**
 * Builds standard API Gateway HTTP Proxy responses with correct CORS configurations
 */
function buildResponse(statusCode, body, event) {
    const reqOrigin = event?.headers?.origin || event?.headers?.Origin || "https://admin.verstantly.com";

    return {
        statusCode,
        headers: {
            "Content-Type": "application/json",
            "Access-Control-Allow-Origin": reqOrigin,
            "Access-Control-Allow-Headers": "Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token,X-Requested-With,Accept",
            "Access-Control-Allow-Methods": "PUT,POST,GET,DELETE,OPTIONS"
        },
        body: JSON.stringify(body)
    };
}
