import { S3Client, PutObjectCommand } from "@aws-sdk/client-s3";

const s3 = new S3Client({});
const BUCKET_NAME = "ajaybetham-sta";

export const handler = async (event) => {
    let path = event.rawPath || event.requestContext?.http?.path || event.path || "/";
    let httpMethod = event.requestContext?.http?.method || event.httpMethod || "GET";

    const corsHeaders = {
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET,POST,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type"
    };

    if (httpMethod === "OPTIONS") {
        return { statusCode: 200, headers: corsHeaders, body: "" };
    }

    try {
        // ==========================================
        // ROUTE 1: DIRECT BINARY UPLOAD TO S3
        // ==========================================
        if (httpMethod === "POST" && path.includes("/upload")) {
            const headers = event.headers || {};
            
            // Extract metadata passed via custom headers to avoid dealing with complex multipart boundary parsing
            const filename = headers["x-filename"] || "image.jpg";
            const language = headers["x-language"] || "english";
            const contentType = headers["content-type"] || "image/jpeg";

            // Determine safe structural folder routing target
            let folderPrefix = "english/";
            if (language === "telugu") folderPrefix = "telugu/";
            if (language === "tamil") folderPrefix = "tamil/";

            let safeFileName = filename.replace(/\s+/g, "_");
            if (safeFileName.endsWith('.JPG') || safeFileName.endsWith('.JPEG')) {
                safeFileName = safeFileName.replace(/\.JPG$/, '.jpg').replace(/\.JPEG$/, '.jpeg');
            }

            const s3Key = `${folderPrefix}${safeFileName}`;

            // Decode base64 payload passed by API Gateway / Lambda Function URL proxy structure
            const fileBuffer = event.isBase64Encoded 
                ? Buffer.from(event.body, "base64") 
                : Buffer.from(event.body);

            await s3.send(new PutObjectCommand({
                Bucket: BUCKET_NAME,
                Key: s3Key,
                Body: fileBuffer,
                ContentType: contentType
            }));

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({ success: true, s3Key })
            };
        }

        // ==========================================
        // ROUTE 2: SERVE ONE-CLICK MOBILE UPLOAD UI
        // ==========================================
        if (httpMethod === "GET") {
            let h = `<!DOCTYPE html>
            <html lang="en">
            <head>
                <meta charset="UTF-8">
                <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
                <title>Verstantly Publisher</title>
                <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
                <style>
                    body { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; margin: 0; background: #0f172a; font-family: 'Inter', sans-serif; color: white; padding: 20px; box-sizing: border-box; }
                    .card { background: #1e293b; border: 1px solid rgba(255,255,255,0.08); padding: 32px 24px; border-radius: 24px; width: 100%; max-width: 420px; box-shadow: 0 20px 40px rgba(0,0,0,0.4); box-sizing: border-box; text-align: center; }
                    .logo { width: 60px; height: 60px; margin-bottom: 16px; object-fit: contain; }
                    h2 { margin: 0 0 8px 0; font-size: 22px; font-weight: 700; color: #f8fafc; }
                    p { margin: 0 0 28px 0; font-size: 14px; color: #94a3b8; }
                    
                    label { display: block; text-align: left; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #38bdf8; margin-bottom: 8px; }
                    
                    .lang-group { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 24px; }
                    .lang-option { position: relative; }
                    .lang-option input { position: absolute; opacity: 0; width: 0; height: 0; }
                    .lang-label { display: flex; align-items: center; justify-content: center; height: 46px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; font-size: 13px; font-weight: 600; color: #94a3b8; cursor: pointer; transition: all 0.2s ease; }
                    .lang-option input:checked + .lang-label { background: #38bdf8; border-color: #38bdf8; color: #0f172a; }
                    
                    .file-zone { position: relative; border: 2px dashed rgba(255,255,255,0.15); border-radius: 16px; padding: 32px 16px; margin-bottom: 28px; cursor: pointer; transition: border-color 0.2s; background: rgba(255,255,255,0.01); }
                    .file-zone:hover, .file-zone.dragover { border-color: #38bdf8; background: rgba(56, 189, 248, 0.03); }
                    .file-zone input { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
                    .file-msg { font-size: 14px; color: #cbd5e1; font-weight: 500; }
                    .file-hint { font-size: 11px; color: #64748b; margin-top: 4px; }
                    
                    .btn { width: 100%; height: 50px; background: #38bdf8; color: #0f172a; border: none; border-radius: 14px; font-size: 15px; font-weight: 700; cursor: pointer; transition: all 0.2s ease; display: flex; align-items: center; justify-content: center; }
                    .btn:hover { background: #7dd3fc; transform: translateY(-1px); }
                    .btn:disabled { background: #334155; color: #64748b; cursor: not-allowed; transform: none; }
                    
                    .status { font-size: 13px; font-weight: 500; margin-top: 16px; display: none; padding: 10px; border-radius: 10px; text-align: left; }
                    .status.success { display: block; background: rgba(34, 197, 94, 0.1); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.2); }
                    .status.error { display: block; background: rgba(244, 63, 94, 0.1); color: #f43f5e; border: 1px solid rgba(244, 63, 94, 0.2); }
                    .status.loading { display: block; background: rgba(56, 189, 248, 0.1); color: #38bdf8; border: 1px solid rgba(56, 189, 248, 0.2); }
                </style>
            </head>
            <body>
                <div class="card">
                    <img src="https://ajaybetham-sta.s3.amazonaws.com/logo.png" class="logo" alt="Logo" onerror="this.style.display='none'">
                    <h2>Publish New Verse</h2>
                    <p>Upload your files instantly with a single touch.</p>
                    
                    <form id="uploadForm" onsubmit="handleUpload(event)">
                        <label>Select Channel Language</label>
                        <div class="lang-group">
                            <div class="lang-option">
                                <input type="radio" id="lang-en" name="language" value="english" checked>
                                <label for="lang-en" class="lang-label">English</label>
                            </div>
                            <div class="lang-option">
                                <input type="radio" id="lang-te" name="language" value="telugu">
                                <label for="lang-te" class="lang-label">తెలుగు</label>
                            </div>
                            <div class="lang-option">
                                <input type="radio" id="lang-ta" name="language" value="tamil">
                                <label for="lang-ta" class="lang-label">தமிழ்</label>
                            </div>
                        </div>
                        
                        <label>Choose File</label>
                        <div class="file-zone" id="dropZone">
                            <input type="file" id="fileInput" accept="image/*" onchange="fileChanged()">
                            <div class="file-msg" id="fileMsg">Tap to open Gallery / Camera</div>
                            <div class="file-hint" id="fileHint">Supports JPEG, PNG, WEBP</div>
                        </div>
                        
                        <button type="submit" class="btn" id="submitBtn" disabled>Upload Instantly</button>
                    </form>
                    
                    <div id="statusBox" class="status"></div>
                </div>

                <script>
                    const zone = document.getElementById('dropZone');
                    const input = document.getElementById('fileInput');
                    const msg = document.getElementById('fileMsg');
                    const hint = document.getElementById('fileHint');
                    const btn = document.getElementById('submitBtn');
                    const status = document.getElementById('statusBox');

                    function fileChanged() {
                        if(input.files && input.files[0]) {
                            const file = input.files[0];
                            if (file.size > 5.8 * 1024 * 1024) {
                                alert("File is too large. Please select an image under 6MB.");
                                input.value = "";
                                btn.disabled = true;
                                return;
                            }
                            msg.innerText = file.name;
                            hint.innerText = (file.size / (1024 * 1024)).toFixed(2) + " MB";
                            btn.disabled = false;
                        } else {
                            msg.innerText = "Tap to open Gallery / Camera";
                            hint.innerText = "Supports JPEG, PNG, WEBP";
                            btn.disabled = true;
                        }
                    }

                    async function handleUpload(e) {
                        e.preventDefault();
                        if(!input.files || !input.files[0]) return;
                        
                        const file = input.files[0];
                        const lang = document.querySelector('input[name="language"]:checked').value;
                        
                        btn.disabled = true;
                        status.className = "status loading";
                        status.innerText = "Uploading asset binary stream directly...";

                        try {
                            const uploadEndpoint = window.location.pathname.replace(/\\/$/, '') + "/upload";
                            
                            // Send file stream in one single POST action using custom parameters tucked inside HTTP headers
                            const response = await fetch(uploadEndpoint, {
                                method: "POST",
                                headers: {
                                    "Content-Type": file.type || "image/jpeg",
                                    "x-filename": file.name,
                                    "x-language": lang
                                },
                                body: file
                            });

                            if(!response.ok) throw new Error("Server rejected binary payload ingestion pipeline.");
                            const result = await response.json();

                            status.className = "status success";
                            status.innerHTML = "<strong>Success!</strong> Uploaded directly to: <br><small style='word-break:break-all; opacity:0.8;'>" + result.s3Key + "</small>";
                            
                            input.value = "";
                            fileChanged();
                        } catch(err) {
                            console.error(err);
                            status.className = "status error";
                            status.innerText = "Upload execution failed: " + err.message;
                            btn.disabled = false;
                        }
                    }
                </script>
            </body>
            </html>`;
            return {
                statusCode: 200,
                headers: { "Content-Type": "text/html" },
                body: h
            };
        }

        return {
            statusCode: 404,
            headers: { "Content-Type": "application/json", ...corsHeaders },
            body: JSON.stringify({ error: "Route not found." })
        };

    } catch (err) {
        console.error(err);
        return {
            statusCode: 500,
            headers: { "Content-Type": "application/json", ...corsHeaders },
            body: JSON.stringify({ error: err.message })
        };
    }
};
