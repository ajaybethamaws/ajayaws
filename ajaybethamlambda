def lambda_handler(event, context):
    global image_cache

    event = ensure_dict(event)
    
    if event.get('warmer'):
        logger.info("Warmer pulse processed.")
        return {'statusCode': 200, 'body': 'warmed'}

    try:
        path = event.get('rawPath', event.get('path', '/'))
        clean_path = path.strip('/').lower()
        
        if clean_path == "increment-view":
            try:
                raw_body = event.get('body', '{}') or '{}'
                if event.get('isBase64Encoded', False):
                    raw_body = base64.b64decode(raw_body).decode('utf-8')
                
                body = ensure_dict(raw_body)
                image_id = body.get('image_id')
                language = str(body.get('language', 'english')).strip().lower()
                
                if image_id:
                    normalized_id = image_id.strip().lower()
                    dynamo_client.update_item(
                        TableName=TABLE_NAME,
                        Key={'image_id': {'S': normalized_id}},
                        UpdateExpression="SET #v = if_not_exists(#v, :zero) + :inc",
                        ExpressionAttributeNames={'#v': 'views'},
                        ExpressionAttributeValues={':zero': {'N': '0'}, ':inc': {'N': '1'}}
                    )

                    # Analytics are deliberately isolated so a reporting failure
                    # never prevents the existing cumulative counter from working.
                    try:
                        record_daily_view(normalized_id, language)
                    except Exception as analytics_err:
                        logger.error(
                            f"Daily analytics update failed for image [{normalized_id}]: "
                            f"{str(analytics_err)}"
                        )
                return {
                    'statusCode': 200, 
                    'headers': {
                        'Content-Type': 'application/json',
                        'Access-Control-Allow-Origin': '*',
                        'Access-Control-Allow-Methods': 'POST,OPTIONS',
                        'Access-Control-Allow-Headers': 'Content-Type'
                    }, 
                    'body': json.dumps({'success': True})
                }
            except Exception as metric_err:
                logger.error(f"Failed to record background view metric safely: {str(metric_err)}")
                return {
                    'statusCode': 200,
                    'headers': {'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*'},
                    'body': json.dumps({'success': False, 'error': str(metric_err)})
                }

        if clean_path == "robots.txt":
            return {
                'statusCode': 200,
                'headers': {
                    'Content-Type': 'text/plain; charset=UTF-8',
                    'Cache-Control': 'public, max-age=3600'
                },
                'body': 'User-agent: *\nAllow: /\nSitemap: https://verstantly.com/sitemap.xml\n'
            }

        if clean_path == "about":
            return {
                'statusCode': 200,
                'headers': {
                    'Content-Type': 'text/html; charset=UTF-8',
                    'Cache-Control': 'public, max-age=3600'
                },
                'body': build_about_page()
