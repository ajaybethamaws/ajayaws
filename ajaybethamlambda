CACHE_TTL_SECONDS = 300  # 5-minute global cache window

def ensure_dict(value, default=None):
    """Return a dictionary when Lambda/API Gateway supplied JSON as a string."""
    fallback = {} if default is None else default
    if isinstance(value, dict):
        return value
    if isinstance(value, str):
        try:
            decoded = json.loads(value)
            return decoded if isinstance(decoded, dict) else fallback
        except (TypeError, ValueError):
            return fallback
    return fallback

def get_cached_db_assets(folder_prefix, search_query=''):
    global image_cache
    current_time = time.time()
    
    if folder_prefix == "telugu/":
        cache_key = 'telugu'
    elif folder_prefix == "tamil/":
        cache_key = 'tamil'
    else:
        cache_key = 'english'
    
    if not image_cache[cache_key]['items'] or (current_time - image_cache[cache_key]['last_updated'] > CACHE_TTL_SECONDS):
        logger.info(f"Database layout cache stale for category [{cache_key}]. Re-indexing from DynamoDB table...")
        try:
            paginator = dynamo_client.get_paginator('scan')
            db_items = []
            for page in paginator.paginate(TableName=TABLE_NAME):
                db_items.extend(page.get('Items', []))
            
            filtered_group = []
            for item in db_items:
                s3_key = item.get('s3_key', {}).get('S', '')
                if s3_key.lower().startswith(folder_prefix.lower()):
                    raw_ts = (
                        item.get('created_at', {}).get('S') or 
                        item.get('created_at', {}).get('N') or 
                        item.get('timestamp', {}).get('N') or 
                        item.get('timestamp', {}).get('S') or 
                        item.get('date', {}).get('S') or 
                        ''
                    )
                    version_val = item.get('bible_version', {}).get('S', '')
                    
                    filtered_group.append({
                        'id': item.get('image_id', {}).get('S', ''),
                        's3_key': s3_key,
                        'reference': item.get('reference', {}).get('S', ''),
                        'verse_text': item.get('verse_text', {}).get('S', ''),
                        'bible_version': version_val,
                        'copyright': get_copyright_text(version_val, folder_prefix),
                        'sort_value': raw_ts
                    })
            
            filtered_group.sort(key=lambda x: (x['sort_value'], x['id'], x['s3_key']), reverse=True)
            image_cache[cache_key] = {'items': filtered_group, 'last_updated': current_time}
        except Exception as e:
            logger.error(f"Error executing synchronous cache compilation: {str(e)}")
            
    base_items = image_cache[cache_key]['items']
    if search_query:
        query_lower = search_query.lower().strip()
        searched_items = []
        for img in base_items:
            if (query_lower in str(img.get('reference', '')).lower()) or \
               (query_lower in str(img.get('verse_text', '')).lower()) or \
               (query_lower in str(img.get('bible_version', '')).lower()) or \
               (query_lower in str(img.get('id', '')).lower()) or \
               (query_lower in str(img.get('s3_key', '')).lower()):
                searched_items.append(img)
        return searched_items

    return base_items

def find_translation_alternatives(reference):
    """
    Scans language caches to find matching verse IDs and details for the same scriptural reference.
    """
    if not reference:
        return {}
    
    clean_ref = reference.strip().lower()
    translations = {}
    
    lang_map = {
        'english': '',
        'telugu': 'telugu',
        'tamil': 'tamil'
    }
    
    for lang_key, prefix in lang_map.items():
        if not image_cache[lang_key]['items']:
            get_cached_db_assets(prefix + ("/" if prefix else "english/"))
            
        for item in image_cache[lang_key]['items']:
            if item.get('reference', '').strip().lower() == clean_ref:
                # Cached items are normalized dictionaries containing strings,
                # not raw DynamoDB attribute dictionaries such as {'S': 'NIV'}.
                version_val = item.get('bible_version', '')
                translations[lang_key] = {
                    'id': item.get('id', ''),
                    'url': f"{CLOUDFRONT_BASE}/{item.get('s3_key', '')}",
                    'copyright': get_copyright_text(version_val, prefix + ("/" if prefix else "english/")),
                    'reference': item.get('reference', ''),
                    'verse_text': item.get('verse_text', '')
                }
                break
                
    return translations

def get_single_db_asset(image_id, folder_prefix):
    try:
        resp = dynamo_client.get_item(
            TableName=TABLE_NAME,
            Key={'image_id': {'S': image_id}}
        )
        item = resp.get('Item')
        if item:
            s3_key = item.get('s3_key', {}).get('S', '')
            if not s3_key.lower().startswith(folder_prefix.lower()):
                return None
               
            version_val = item.get('bible_version', {}).get('S', '') 
            return {
                'id': item.get('image_id', {}).get('S', ''),
                's3_key': s3_key,
                'reference': item.get('reference', {}).get('S', ''),
                'verse_text': item.get('verse_text', {}).get('S', ''),
                'bible_version': version_val,
                'copyright': get_copyright_text(version_val, folder_prefix)
            }
    except Exception as e:
        logger.error(f"Failed direct target item lookup query on ID [{image_id}]: {str(e)}")
    return None

def lambda_handler(event, context):
    global image_cache

    event = ensure_dict(event)
    
    if event.get('warmer'):
        logger.info("Warmer pulse processed.")
        return {'statusCode': 200, 'body': 'warmed'}

    try:
        path = event.get('rawPath', event.get('path', '/'))
        clean_path = path.strip('/').lower()
        
        if clean_path == "increment-view":
