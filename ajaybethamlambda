        h += '<div class="icon-btn bell-btn" onclick="toggleM(event)"><svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24"><path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5 1.5-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z"/></svg></div>'
        h += '<div id="subM" class="modal" onclick="event.stopPropagation()"><p style="margin:0 0 10px 0; font-size:14px; color:#cbd5e1;">Receive daily verses:</p><input type="email" id="uE" placeholder="Enter email"><button id="sBtn" onclick="sub()">Be Refreshed</button></div>'
        
        h += '<div class="header-container">'
        h += '  <div class="profile-logo-wrapper">'
        h += '    <div class="profile-logo"><img src="/logo.png" alt="Logo"></div>'
        h += '  </div>'
        
        # Localized Banner Mapping
        if lang_mode == "telugu":
            h += '  <p class="banner-text">"దేవుని మాటలన్నియు పుటము పెట్టబడినవే ఆయనను ఆశ్రయించువారికి ఆయన కేడెము."</p>'
            h += '  <p class="banner-reference">సామెతలు 30:5</p>'
        elif lang_mode == "tamil":
            h += '  <p class="banner-text">"தேவனுடைய வார்த்தையெல்லாம் புடமிடப்பட்டவை; தம்மை அண்டிக்கொள்ளுகிறவர்களுக்கு அவர் கேடகமானவர்."</p>'
            h += '  <p class="banner-reference">நீதிமொழிகள் 30:5</p>'
        else:
            h += '  <p class="banner-text">"Every word of God is pure; He is a shield to those who put their trust in Him."</p>'
            h += '  <p class="banner-reference">Proverbs 30:5</p>'
            
        # SEARCH INPUT FIELD COMPONENT
        h += '  <div class="search-bar-wrapper">'
        h += '    <span class="search-icon"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg></span>'
        h += f'    <input type="text" id="searchInput" class="search-input" value="{search_query}" placeholder="Search verses or references..." onkeypress="handleSearch(event)">'
        h += '  </div>'
        
        h += '</div>'
        h += '<div class="divider"></div>'
        
        # RENDERING GALLERY TILES
        h += '<div class="gallery-grid">'
        client_js_array = []
        for idx, img in enumerate(images):
            full_cf_url = f"{CLOUDFRONT_BASE}/{img['s3_key']}"
            client_js_array.append({
                'id': img['id'], 
                'url': full_cf_url,
                'copyright': img.get('copyright', '')
            })
            
            h += f'<div class="grid-item" id="tile-{img["id"]}" onclick="openLightbox({idx})">'
            h += f'<img src="{full_cf_url}" loading="lazy" alt="Verse Asset">'
            h += '</div>'
        h += '</div>'
        
        # LIGHTBOX INJECTION LAYOUT
        h += '<div id="lightbox" class="lightbox" onclick="closeLightbox()">'
        h += '  <div id="lbContent" class="lightbox-content" onclick="event.stopPropagation()">'
        h += '    <div class="img-frame">'
        h += '      <img id="lightbox-img" class="lightbox-img" src="" alt="Expanded Verse">'
        h += '      <div class="protection-shield"></div>'
        h += '      <div class="watermark-overlay"><img src="/logo.png" alt="Watermark Logo"></div>'
        h += '    </div>'
        h += '    <div id="lightbox-copyright" class="lightbox-copyright"></div>'
        h += '    <div class="lightbox-actions">'
        h += '      <div class="lightbox-btn" onclick="prevAsset()" title="Previous Image">'
        h += '        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"/></svg>'
        h += '      </div>'
        h += '      <div class="lightbox-btn close-btn" onclick="closeLightbox()" title="Close">'
        h += '        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>'
        h += '      </div>'
        h += '      <div class="lightbox-btn" onclick="shareCurrentAsset()" title="Share Link">'
        h += '        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>'
        h += '      </div>'
        h += '      <div class="lightbox-btn" onclick="nextAsset()" title="Next Image">'
        h += '        <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>'
        h += '      </div>'
        h += '    </div>'
        h += '  </div>'
        h += '</div>'
        
        # FRONTEND ROUTER SCRIPTS + SEARCH HANDLER
        h += ' <script>const m=document.getElementById("subM"), lb=document.getElementById("lightbox"), lbImg=document.getElementById("lightbox-img"), lbContent=document.getElementById("lbContent");'
        h += f'const metadataVault = {json.dumps(client_js_array)};'
        h += 'let activeIdx = null;'
        h += 'let startY = 0, currentY = 0, isDragging = false;'
        
        h += 'function toggleM(e){ e.stopPropagation(); m.style.display=(m.style.display==="block")?"none":"block"; }'
        h += 'function closeM(){ m.style.display="none"; }'
        h += 'async function sub(){ const e=document.getElementById("uE"),b=document.getElementById("sBtn"); if(!e.value.includes("@"))return alert("Valid email please!"); b.disabled=true; b.innerText="..."; try{ await fetch("' + SUBSCRIBER_URL + '",{method:"POST",mode:"no-cors",body:JSON.stringify({email:e.value.trim()})}); alert("Subscribed! Be Refreshed."); e.value=""; closeM(); }catch(err){ alert("Subscribed!"); closeM(); } b.disabled=false; b.innerText="Be Refreshed"; }'
        
        # SEARCH SUBMISSION HANDLER
        h += 'function handleSearch(e) {'
        h += '  if (e.key === "Enter") {'
        h += '    const query = e.target.value.trim();'
        h += '    const urlObj = new URL(window.location.href);'
        h += '    if (query) {'
        h += '      urlObj.searchParams.set("q", query);'
        h += '    } else {'
        h += '      urlObj.searchParams.delete("q");'
        h += '    }'
        h += '    window.location.href = urlObj.toString();'
        h += '  }'
        h += '}'
        
        # BACKGROUND FETCH TO TRACK ALBUM VIEWS & POPULATE COPYRIGHT
        h += 'function openLightbox(index) {'
        h += '  activeIdx = index;'
        h += '  lbImg.src = metadataVault[index].url;'
        h += '  document.getElementById("lightbox-copyright").innerText = metadataVault[index].copyright || "";'
        h += '  lb.classList.add("show");'
        h += '  lbContent.style.transform = "translateY(0)";'
        h += '  const targetId = metadataVault[index].id;'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.searchParams.set("id", targetId);'
        h += '  window.history.replaceState({path:urlObj.toString()}, "", urlObj.toString());'
        h += '  fetch("/increment-view", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ image_id: targetId }) }).catch(() => {});'
        h += '}'
        
        h += 'function closeLightbox() {'
        h += '  lb.classList.remove("show");'
        h += '  activeIdx = null;'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.searchParams.delete("id");'
        h += '  window.history.replaceState({path:urlObj.toString()}, "", urlObj.toString());'
        h += '}'
        
        h += 'function nextAsset() {'
        h += '  if(activeIdx === null || metadataVault.length === 0) return;'
        h += '  let nextIdx = (activeIdx + 1) % metadataVault.length;'
        h += '  openLightbox(nextIdx);'
        h += '}'
        
        h += 'function prevAsset() {'
        h += '  if(activeIdx === null || metadataVault.length === 0) return;'
        h += '  let prevIdx = (activeIdx - 1 + metadataVault.length) % metadataVault.length;'
        h += '  openLightbox(prevIdx);'
        h += '}'
        
        h += 'function shareCurrentAsset(){'
        h += '  if(activeIdx === null) return;'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.searchParams.set("id", metadataVault[activeIdx].id);'
        h += '  const shareUrl = urlObj.toString();'
        h += '  if(navigator.share){'
        h += '    navigator.share({title: document.title, url: shareUrl});'
        h += '  } else {'
        h += '    navigator.clipboard.writeText(shareUrl);'
        h += '    alert("Permanent link to this specific verse copied!");'
        h += '  }'
        h += '}'
        
        document_event_listeners = 'document.addEventListener("keydown", e => {'
        document_event_listeners += '  if (!lb.classList.contains("show")) return;'
        document_event_listeners += '  if (e.key === "ArrowRight") nextAsset();'
        document_event_listeners += '  if (e.key === "ArrowLeft") prevAsset();'
        document_event_listeners += '  if (e.key === "Escape") closeLightbox();'
        document_event_listeners += '});'
        h += document_event_listeners
        
        # TOUCH LAYER GESTURES
        h += 'let startX = 0, currentX = 0;'
        h += 'lb.addEventListener("touchstart", e => { startY = e.touches[0].clientY; startX = e.touches[0].clientX; isDragging = true; }, {passive: true});'
        h += 'lb.addEventListener("touchmove", e => {'
        h += '  if (!isDragging) return;'
        h += '  currentY = e.touches[0].clientY;'
        h += '  currentX = e.touches[0].clientX;'
        h += '  let deltaY = currentY - startY;'
        h += '  let deltaX = currentX - startX;'
        h += '  if (deltaY > 0 && Math.abs(deltaY) > Math.abs(deltaX)) { lbContent.style.transform = `translateY(${deltaY}px)`; }'
        h += '}, {passive: true});'
        h += 'lb.addEventListener("touchend", e => {'
        h += '  if (!isDragging) return;'
        h += '  isDragging = false;'
        h += '  let deltaY = currentY - startY;'
        h += '  let deltaX = currentX - startX;'
        h += '  if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 60) {'
        h += '    if (deltaX < 0) { nextAsset(); } else { prevAsset(); }'
        h += '  } else if (deltaY > 120) { closeLightbox(); } else { lbContent.style.transform = "translateY(0)"; }'
        h += '});'
        
        h += 'document.addEventListener("contextmenu", e => e.preventDefault());'
        
        # DEEP-LINK INITIALIZATION RESOLVER
        h += f'const initialUrlId = "{url_id if url_id else ""}";'
        h += 'window.onload = () => {'
        h += '  if (initialUrlId) {'
        h += '    const matchedIndex = metadataVault.findIndex(item => item.id.toLowerCase() === initialUrlId.toLowerCase());'
        h += '    if (matchedIndex !== -1) { openLightbox(matchedIndex); }'
        h += '  }'
        h += '};'
        
        h += '</script></body></html>'

        return {'statusCode': 200, 'headers': {'Content-Type': 'text/html'}, 'body': h}
    except Exception as e:
        logger.error(str(e))
        return {'statusCode': 500, 'body': 'System Error'}
