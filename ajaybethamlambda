        h += '  imgLoader.onload = () => {'
        h += '    lbImg.style.opacity = "0.3";'
        h += '    setTimeout(() => {'
        h += '      lbImg.src = target.url;'
        h += '      document.getElementById("lightbox-copyright").innerText = target.copyright || "";'
        h += '      lbImg.style.opacity = "1";'
        h += '    }, 100);'
        h += '  };'
        
        # Update active pill states and browser URL gracefully
        h += '  document.getElementById("lnkEn").className = "lb-lang-pill" + (langKey === "english" ? " active" : "");'
        h += '  document.getElementById("lnkTe").className = "lb-lang-pill" + (langKey === "telugu" ? " active" : "");'
        h += '  document.getElementById("lnkTa").className = "lb-lang-pill" + (langKey === "tamil" ? " active" : "");'
        h += '  document.getElementById("lnkHi").className = "lb-lang-pill" + (langKey === "hindi" ? " active" : "");'
        
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.pathname = langKey === "english" ? "/" : "/" + langKey;'
        h += '  urlObj.searchParams.set("id", target.id);'
        h += '  window.history.replaceState({path:urlObj.toString()}, "", urlObj.toString());'
        
        h += '  fetch("/increment-view", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ image_id: target.id, language: langKey }) }).catch(() => {});'
        h += '}'
        
        # LIGHTBOX OPEN WITH DYNAMIC TRANSLATION PILLS TOGGLE
        h += 'function openLightbox(index) {'
        h += '  activeIdx = index;'
        h += '  const asset = metadataVault[index];'
        h += '  activeAssetId = asset.id;'
        h += f'  activeLanguage = "{lang_mode}";'
        h += '  lbImg.src = asset.url;'
        h += '  document.getElementById("lightbox-copyright").innerText = asset.copyright || "";'
        h += '  lb.classList.add("show");'
        h += '  lbContent.style.transform = "translateY(0)";'
        
        h += '  const targetId = asset.id;'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.searchParams.set("id", targetId);'
        h += '  window.history.replaceState({path:urlObj.toString()}, "", urlObj.toString());'
        
        # Manage language switcher UI elements inside lightbox
        h += '  const switcher = document.getElementById("lightboxLangSwitcher");'
        h += '  const lnkEn = document.getElementById("lnkEn");'
        h += '  const lnkTe = document.getElementById("lnkTe");'
        h += '  const lnkTa = document.getElementById("lnkTa");'
        h += '  const lnkHi = document.getElementById("lnkHi");'
        h += '  const trans = asset.translations || {};'
        
        h += '  switcher.style.display = "flex";'
        
        # Determine current active language based on which translation matches the active asset or the page mode
        h += '  const currentLang = "' + lang_mode + '";'
        
        # Alternatively, check against whichever language version matches the item's prefix/id
        h += '  if (trans.english) { lnkEn.className = "lb-lang-pill" + (trans.english.id === targetId ? " active" : ""); }'
        h += '  else { lnkEn.className = "lb-lang-pill disabled"; }'
        
        h += '  if (trans.telugu) { lnkTe.className = "lb-lang-pill" + (trans.telugu.id === targetId ? " active" : ""); }'
        h += '  else { lnkTe.className = "lb-lang-pill disabled"; }'
        
        h += '  if (trans.tamil) { lnkTa.className = "lb-lang-pill" + (trans.tamil.id === targetId ? " active" : ""); }'
        h += '  else { lnkTa.className = "lb-lang-pill disabled"; }'

        h += '  if (trans.hindi) { lnkHi.className = "lb-lang-pill" + (trans.hindi.id === targetId ? " active" : ""); }'
        h += '  else { lnkHi.className = "lb-lang-pill disabled"; }'
        
        h += f'  fetch("/increment-view", {{ method: "POST", headers: {{ "Content-Type": "application/json" }}, body: JSON.stringify({{ image_id: targetId, language: "{lang_mode}" }}) }}).catch(() => {{}});'
        h += '}'
        
        h += 'function closeLightbox() {'
        h += '  lb.classList.remove("show");'
        h += '  activeIdx = null;'
        h += '  activeAssetId = null;'
        h += f'  activeLanguage = "{lang_mode}";'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.searchParams.delete("id");'
        h += '  window.history.replaceState({path:urlObj.toString()}, "", urlObj.toString());'
        h += '}'
        
        h += 'function nextAsset() {'
        h += '  if(activeIdx === null || metadataVault.length === 0) return;'
        h += '  let nextIdx = (activeIdx + 1) % metadataVault.length;'
        h += '  openLightbox(nextIdx);'
        h += '}'
        
        h += 'function prevAsset() {'
        h += '  if(activeIdx === null || metadataVault.length === 0) return;'
        h += '  let prevIdx = (activeIdx - 1 + metadataVault.length) % metadataVault.length;'
        h += '  openLightbox(prevIdx);'
        h += '}'
        
        h += 'function shareCurrentAsset(){'
        h += '  if(activeIdx === null || !activeAssetId) return;'
        h += '  const urlObj = new URL(window.location.href);'
        h += '  urlObj.pathname = activeLanguage === "english" ? "/" : "/" + activeLanguage;'
        h += '  urlObj.searchParams.set("id", activeAssetId);'
        h += '  const shareUrl = urlObj.toString();'
        h += '  if(navigator.share){'
        h += '    navigator.share({title: document.title, url: shareUrl});'
        h += '  } else {'
        h += '    navigator.clipboard.writeText(shareUrl);'
        h += '    alert("Permanent link to this specific verse copied!");'
        h += '  }'
        h += '}'
        
        document_event_listeners = 'document.addEventListener("keydown", e => {'
        document_event_listeners += '  if (!lb.classList.contains("show")) return;'
        document_event_listeners += '  if (e.key === "ArrowRight") nextAsset();'
        document_event_listeners += '  if (e.key === "ArrowLeft") prevAsset();'
        document_event_listeners += '  if (e.key === "Escape") closeLightbox();'
        document_event_listeners += '});'
        h += document_event_listeners
        
        h += 'let startX = 0, currentX = 0;'
        h += 'lb.addEventListener("touchstart", e => { startY = e.touches[0].clientY; startX = e.touches[0].clientX; isDragging = true; }, {passive: true});'
        h += 'lb.addEventListener("touchmove", e => {'
        h += '  if (!isDragging) return;'
        h += '  currentY = e.touches[0].clientY;'
        h += '  currentX = e.touches[0].clientX;'
        h += '  let deltaY = currentY - startY;'
        h += '  let deltaX = currentX - startX;'
        h += '  if (deltaY > 0 && Math.abs(deltaY) > Math.abs(deltaX)) { lbContent.style.transform = `translateY(${deltaY}px)`; }'
        h += '}, {passive: true});'
        h += 'lb.addEventListener("touchend", e => {'
        h += '  if (!isDragging) return;'
        h += '  isDragging = false;'
        h += '  let deltaY = currentY - startY;'
        h += '  let deltaX = currentX - startX;'
        h += '  if (Math.abs(deltaX) > Math.abs(deltaY) && Math.abs(deltaX) > 60) {'
        h += '    if (deltaX < 0) { nextAsset(); } else { prevAsset(); }'
        h += '  } else if (deltaY > 120) { closeLightbox(); } else { lbContent.style.transform = "translateY(0)"; }'
        h += '});'
        
        h += 'document.addEventListener("contextmenu", e => e.preventDefault());'
        
        h += f'const initialUrlId = "{url_id if url_id else ""}";'
        h += 'window.onload = () => {'
        h += '  if (initialUrlId) {'
        h += '    const matchedIndex = metadataVault.findIndex(item => item.id.toLowerCase() === initialUrlId.toLowerCase());'
        h += '    if (matchedIndex !== -1) { openLightbox(matchedIndex); }'
        h += '  }'
        h += '};'
        
        h += '</script></body></html>'

        return {'statusCode': 200, 'headers': {'Content-Type': 'text/html'}, 'body': h}
    except Exception as e:
