        h += 'function switchLanguageAlt(langKey) {'
        h += '  if (activeIdx === null) return;'
        h += '  const asset = metadataVault[activeIdx];'
        h += '  const trans = asset.translations || {};'
        h += '  const target = trans[langKey];'
