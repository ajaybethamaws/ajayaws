    retries={'max_attempts': 0},
    tcp_keepalive=True,
    max_pool_connections=50
)
s3_client = boto3.client('s3', region_name=REGION, config=s3_config)

# Global in-memory structured cache
image_cache = {
    'telugu': {'keys': [], 'last_updated': 0},
    'english': {'keys': [], 'last_updated': 0}
}
CACHE_TTL_SECONDS = 600  # 10 minutes cache expiration

def get_sorted_images(folder_prefix):
    global image_cache
    current_time = time.time()
    cache_key = 'telugu' if folder_prefix == "telugu/" else 'english'
    
    # Refresh cache if empty or TTL expired
    if not image_cache[cache_key]['keys'] or (current_time - image_cache[cache_key]['last_updated'] > CACHE_TTL_SECONDS):
        logger.info(f"Cache expired or empty for {folder_prefix}. Fetching and sorting from S3...")
        try:
            resp = s3_client.list_objects_v2(Bucket=BUCKET_NAME, Prefix=folder_prefix, MaxKeys=1000)
            contents = resp.get('Contents', [])
            
            # Filter and sort by LastModified (Newest First)
            valid_images = [obj for obj in contents if obj['Key'].lower().endswith(('.jpg', '.jpeg'))]
            valid_images.sort(key=lambda x: x['LastModified'], reverse=True)
            
            sorted_keys = [obj['Key'] for obj in valid_images]
            
            image_cache[cache_key] = {
                'keys': sorted_keys,
                'last_updated': current_time
            }
        except Exception as e:
            logger.error(f"Error updating S3 asset cache: {str(e)}")
            
    return image_cache[cache_key]['keys']

def lambda_handler(event, context):
    global image_cache
    
    # --- SECTION 0: WARMER LOGIC ---
    if event.get('warmer'):
        logger.info("Warmer pulse received. Image cache is active.")
        return {'statusCode': 200, 'body': 'warmed'}
    # -------------------------------

    try:
        path = event.get('rawPath', event.get('path', '/'))
        clean_path = path.strip('/')
        is_telugu = clean_path.lower() == "telugu"
        folder_prefix = "telugu/" if is_telugu else "english/"

        # 1. DIRECT ASSET ROUTING
        if clean_path in ["favicon.ico", "apple-touch-icon.png", "logo.png"]:
            return {'statusCode': 302, 'headers': {'Location': f"{S3_DIRECT_URL}/{clean_path}"}, 'body': ''}

        query_params = event.get('queryStringParameters', {}) or {}
        
        # Admin cache flush tool (ajaybetham.com/?refresh=true)
        if query_params.get('refresh') == 'true':
            image_cache = {'telugu': {'keys': [], 'last_updated': 0}, 'english': {'keys': [], 'last_updated': 0}}
            logger.info("Cache manually cleared via query parameter.")

        # 2. IMAGE ROTATION LOGIC (Sequential Newest to Oldest)
        if query_params and 't' in query_params:
            images = get_sorted_images(folder_prefix)
            if not images:
                return {'statusCode': 404, 'body': 'No images found'}
            
            total_images = len(images)
            
            # Parse requested index from client; default to 0 (Latest)
            try:
                requested_idx = int(query_params.get('idx', 0))
                # Loop back to 0 if we exceed total images
                index = requested_idx % total_images
            except ValueError:
                index = 0

            selected = images[index]
            logger.info(f"Serving image index {index}/{total_images - 1}: {selected}")
            
            return {
                'statusCode': 302,
                'headers': {
                    'Location': f"{S3_DIRECT_URL}/{selected}?v={int(time.time())}",
                    'Cache-Control': 'no-store, no-cache, must-revalidate',
                    'Access-Control-Allow-Origin': '*'
                }, 'body': ''
            }

