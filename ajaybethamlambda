# Global in-memory structured cache
image_cache = {
    'telugu': {'keys': [], 'last_updated': 0},
    'english': {'keys': [], 'last_updated': 0}
}
CACHE_TTL_SECONDS = 600

def get_sorted_images(folder_prefix):
    global image_cache
    current_time = time.time()
    cache_key = 'telugu' if folder_prefix == "telugu/" else 'english'
    
    if not image_cache[cache_key]['keys'] or (current_time - image_cache[cache_key]['last_updated'] > CACHE_TTL_SECONDS):
        logger.info(f"Cache expired or empty for {folder_prefix}. Fetching and sorting from S3...")
        try:
            resp = s3_client.list_objects_v2(Bucket=BUCKET_NAME, Prefix=folder_prefix, MaxKeys=1000)
            contents = resp.get('Contents', [])
            valid_images = [obj for obj in contents if obj['Key'].lower().endswith(('.jpg', '.jpeg'))]
            valid_images.sort(key=lambda x: x['LastModified'], reverse=True)
            sorted_keys = [obj['Key'] for obj in valid_images]
            image_cache[cache_key] = {'keys': sorted_keys, 'last_updated': current_time}
        except Exception as e:
            logger.error(f"Error updating S3 asset cache: {str(e)}")
    return image_cache[cache_key]['keys']

