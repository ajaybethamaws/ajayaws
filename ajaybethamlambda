def get_copyright_text(version, folder_prefix):
    # Static courtesy statement for Telugu and Tamil assets by default without Dynamo DB look up
    folder_lower = folder_prefix.lower()
    if folder_lower == "telugu/":
        return BIBLE_COPYRIGHTS["TELUGU"]
    elif folder_lower == "tamil/":
        return BIBLE_COPYRIGHTS["TAMIL"]
    
    # Restrict English copyright notices to English assets only
    if folder_lower != "english/" or not version:
        return ""
    clean_ver = version.upper().strip()
    return BIBLE_COPYRIGHTS.get(clean_ver, "")

