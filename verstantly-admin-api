import { S3Client, ListObjectsV2Command, HeadObjectCommand, CopyObjectCommand, DeleteObjectCommand, PutObjectCommand } from "@aws-sdk/client-s3";
import { DynamoDBClient, ScanCommand, PutItemCommand, UpdateItemCommand } from "@aws-sdk/client-dynamodb";
import { SNSClient, PublishCommand } from "@aws-sdk/client-sns";

const s3 = new S3Client({});
const dynamo = new DynamoDBClient({});
const sns = new SNSClient({});

const TABLE_NAME = "verstantly-verse-images";
const BUCKET_NAME = "ajaybetham-sta";

export const handler = async (event, context) => {
    // Prevent Lambda from hanging for open event loop network connections
    if (context) {
        context.callbackWaitsForEmptyEventLoop = false;
    }

    let path = event.rawPath || event.requestContext?.http?.path || event.path || "/";
    let httpMethod = event.requestContext?.http?.method || event.httpMethod || "GET";

    console.log(`[${httpMethod}] Path: ${path}`);

    // Dynamic origin matching to avoid browser CORS rejection
    const reqOrigin = event?.headers?.origin || event?.headers?.Origin || "https://admin.verstantly.com";

    // Complete CORS Headers
    const corsHeaders = {
        "Access-Control-Allow-Origin": reqOrigin,
        "Access-Control-Allow-Methods": "GET,PUT,POST,DELETE,OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type,Authorization,X-Amz-Date,X-Api-Key,X-Amz-Security-Token,X-Requested-With,Accept"
    };

    // Handle Preflight OPTIONS
    if (httpMethod === "OPTIONS") {
        return { 
            statusCode: 200, 
            headers: corsHeaders, 
            body: JSON.stringify({ message: "CORS preflight successful" }) 
        };
    }

    try {
        // ==========================================
        // ROUTE: REAL-TIME INVENTORY LANGUAGE COUNTS
        // ==========================================
        if (httpMethod === "GET" && path.includes("/images/counts")) {
            const s3Response = await s3.send(new ListObjectsV2Command({ Bucket: BUCKET_NAME }));
            const s3Objects = s3Response.Contents || [];

            let english = 0;
            let telugu = 0;
            let tamil = 0;

            s3Objects.forEach(obj => {
                if (obj.Key.endsWith('/')) return;
                const lowerKey = obj.Key.toLowerCase();
                
                if (lowerKey.startsWith('telugu/')) {
                    telugu++;
                } else if (lowerKey.startsWith('tamil/')) {
                    tamil++;
                } else if (lowerKey.startsWith('english/') || !lowerKey.includes('/')) {
                    english++;
                }
            });

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({ english, telugu, tamil })
            };
        }

        // ==========================================
        // ROUTE: UPLOAD NEW IMAGE
        // ==========================================
        if (httpMethod === "POST" && path.includes("/images/upload")) {
            const body = JSON.parse(event.body || "{}");
            const { language, filename, file_type, reference, verse_text, bible_version, image_data } = body;

            if (!filename || !image_data) {
                return {
                    statusCode: 400,
                    headers: { "Content-Type": "application/json", ...corsHeaders },
                    body: JSON.stringify({ success: false, message: "Missing required filename or image data." })
                };
            }

            // Determine correct S3 folder prefix based on selected language
            let folderPrefix = "";
            const cleanLang = (language || "english").toLowerCase();
            if (cleanLang === "telugu") folderPrefix = "telugu/";
            else if (cleanLang === "tamil") folderPrefix = "tamil/";
            else if (cleanLang === "english") folderPrefix = "english/";

            let finalS3Key = `${folderPrefix}${filename}`;
            let baseName = filename.substring(0, filename.lastIndexOf('.')) || filename;
            let fileExt = filename.substring(filename.lastIndexOf('.')) || '';

            // Handle name collisions in S3
            let suffixCounter = 0;
            let isCollision = true;
            while (isCollision) {
                const testFileName = suffixCounter === 0 
                    ? `${baseName}${fileExt}` 
                    : `${baseName}_${suffixCounter}${fileExt}`;
                
                finalS3Key = `${folderPrefix}${testFileName}`;

                try {
                    await s3.send(new HeadObjectCommand({ Bucket: BUCKET_NAME, Key: finalS3Key }));
                    suffixCounter++; 
                } catch (s3Error) {
                    if (s3Error.name === "NotFound" || s3Error.$metadata?.httpStatusCode === 404) {
                        isCollision = false; 
                    } else {
                        throw s3Error; 
                    }
                }
            }

            const buffer = Buffer.from(image_data, 'base64');
            await s3.send(new PutObjectCommand({
                Bucket: BUCKET_NAME,
                Key: finalS3Key,
                Body: buffer,
                ContentType: file_type || "image/jpeg"
            }));

            const newId = `img_${Math.random().toString(36).substring(2, 9)}`;
            const s3EpochTimestamp = Math.floor(Date.now() / 1000).toString();
            const actualFileName = finalS3Key.split('/').pop();

            await dynamo.send(new PutItemCommand({
                TableName: TABLE_NAME,
                Item: {
                    "image_id": { S: newId },
                    "s3_key": { S: finalS3Key },
                    "current_filename": { S: actualFileName },
                    "reference": { S: reference || "" },
                    "verse_text": { S: verse_text || "" },
                    "bible_version": { S: bible_version || "" },
                    "created_at": { S: s3EpochTimestamp }
                }
            }));

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({ success: true, message: "Image uploaded successfully", image_id: newId, s3_key: finalS3Key })
            };
        }

        // ==========================================
        // ROUTE 1: FETCH IMAGES & AUTO-SYNC S3
        // ==========================================
        if (httpMethod === "GET" && path.includes("/images") && !path.includes("/update") && !path.includes("/counts") && !path.includes("/view")) {
            const s3Response = await s3.send(new ListObjectsV2Command({ Bucket: BUCKET_NAME }));
            const s3Objects = s3Response.Contents || [];

            const dbResponse = await dynamo.send(new ScanCommand({ TableName: TABLE_NAME }));
            const dbItems = dbResponse.Items || [];
            
            const dbMap = new Map();
            dbItems.forEach(item => {
                if (item.s3_key?.S) dbMap.set(item.s3_key.S, item);
            });

            const finalImages = [];

            for (const obj of s3Objects) {
                if (obj.Key.endsWith('/')) continue; 

                let targetKey = obj.Key;
                
                const s3EpochTimestamp = obj.LastModified 
                    ? Math.floor(new Date(obj.LastModified).getTime() / 1000).toString() 
                    : Math.floor(Date.now() / 1000).toString();

                if (targetKey.endsWith('.JPG') || targetKey.endsWith('.JPEG')) {
                    const lowCaseKey = targetKey.replace(/\.JPG$/, '.jpg').replace(/\.JPEG$/, '.jpeg');
                    
                    try {
                        await s3.send(new CopyObjectCommand({
                            Bucket: BUCKET_NAME,
                            CopySource: `${BUCKET_NAME}/${targetKey}`,
                            Key: lowCaseKey
                        }));
                        await s3.send(new DeleteObjectCommand({ Bucket: BUCKET_NAME, Key: targetKey }));
                        
                        targetKey = lowCaseKey; 
                    } catch (renameErr) {
                        console.error(`Failed renaming key: ${obj.Key}`, renameErr);
                    }
                }

                if (dbMap.has(targetKey)) {
                    const matchedItem = dbMap.get(targetKey);
                    const existingId = matchedItem.image_id?.S || "";
                    
                    if (!matchedItem.created_at || !matchedItem.created_at.S) {
                        try {
                            await dynamo.send(new UpdateItemCommand({
                                TableName: TABLE_NAME,
                                Key: { "image_id": { S: existingId } },
                                UpdateExpression: "SET #cat = :c",
                                ExpressionAttributeNames: { "#cat": "created_at" },
                                ExpressionAttributeValues: { ":c": { S: s3EpochTimestamp } }
                            }));
                            matchedItem.created_at = { S: s3EpochTimestamp };
                        } catch (updateErr) {
                            console.error(`Failed backfilling timestamp for ID ${existingId}:`, updateErr);
                        }
                    }

                    finalImages.push({
                        image_id: existingId,
                        s3_key: targetKey,
                        current_filename: matchedItem.current_filename?.S || targetKey.split('/').pop(),
                        reference: matchedItem.reference?.S || "",
                        verse_text: matchedItem.verse_text?.S || "",
                        bible_version: matchedItem.bible_version?.S || "",
                        created_at: matchedItem.created_at?.S || s3EpochTimestamp,
                        views: matchedItem.views?.N ? parseInt(matchedItem.views.N, 10) : 0
                    });
                } else {
                    const newId = `img_${Math.random().toString(36).substring(2, 9)}`;
                    const fileName = targetKey.split('/').pop();

                    await dynamo.send(new PutItemCommand({
                        TableName: TABLE_NAME,
                        Item: {
                            "image_id": { S: newId },
                            "s3_key": { S: targetKey },
                            "current_filename": { S: fileName },
                            "reference": { S: "" },
                            "verse_text": { S: "" },
                            "bible_version": { S: "" },
                            "created_at": { S: s3EpochTimestamp }
                        }
                    }));

                    finalImages.push({
                        image_id: newId,
                        s3_key: targetKey,
                        current_filename: fileName,
                        reference: "",
                        verse_text: "",
                        bible_version: "",
                        created_at: s3EpochTimestamp,
                        views: 0
                    });
                }
            }

            finalImages.sort((a, b) => {
                if (b.views !== a.views) return b.views - a.views;
                return parseInt(b.created_at, 10) - parseInt(a.created_at, 10);
            });

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({ images: finalImages })
            };
        }

        // ==========================================
        // ROUTE 2: UPDATE METADATA & SAFE S3 RENAME
        // ==========================================
        if (httpMethod === "PUT" && path.includes("/images")) {
            const body = JSON.parse(event.body || "{}");
            const pathParts = path.split('/');
            const pathId = pathParts[pathParts.length - 1];
            const image_id = body.image_id || body.id || (pathId !== "update" && pathId !== "images" ? pathId : null);
            
            const { s3_key, reference, verse_text, requested_filename, bible_version } = body;

            if (!image_id) {
                return {
                    statusCode: 400,
                    headers: { "Content-Type": "application/json", ...corsHeaders },
                    body: JSON.stringify({ success: false, message: "Missing image_id parameter." })
                };
            }

            let currentS3Key = s3_key;
            if (!currentS3Key) {
                const dbRes = await dynamo.send(new ScanCommand({ TableName: TABLE_NAME }));
                const matched = (dbRes.Items || []).find(i => i.image_id?.S === image_id);
                if (matched) {
                    currentS3Key = matched.s3_key?.S;
                }
            }

            if (!currentS3Key) {
                return {
                    statusCode: 400,
                    headers: { "Content-Type": "application/json", ...corsHeaders },
                    body: JSON.stringify({ success: false, message: "Could not resolve active s3_key for image." })
                };
            }

            let finalS3Key = currentS3Key;
            let finalFileName = requested_filename;
            const currentFileName = currentS3Key.split('/').pop();

            if (finalFileName && (finalFileName.endsWith('.JPG') || finalFileName.endsWith('.JPEG'))) {
                finalFileName = finalFileName.replace(/\.JPG$/, '.jpg').replace(/\.JPEG$/, '.jpeg');
            }

            if (finalFileName && finalFileName !== currentFileName) {
                const extIndex = finalFileName.lastIndexOf('.');
                const baseName = extIndex !== -1 ? finalFileName.substring(0, extIndex) : finalFileName;
                const fileExt = extIndex !== -1 ? finalFileName.substring(extIndex) : '';

                const pathSegments = currentS3Key.split('/');
                pathSegments.pop();
                const folderPrefix = pathSegments.length > 0 ? pathSegments.join('/') + '/' : '';

                let suffixCounter = 0;
                let isCollision = true;

                while (isCollision) {
                    const testFileName = suffixCounter === 0 
                        ? `${baseName}${fileExt}` 
                        : `${baseName}_${suffixCounter}${fileExt}`;
                    
                    const testS3Key = `${folderPrefix}${testFileName}`;

                    try {
                        await s3.send(new HeadObjectCommand({ Bucket: BUCKET_NAME, Key: testS3Key }));
                        suffixCounter++; 
                    } catch (s3Error) {
                        if (s3Error.name === "NotFound" || s3Error.$metadata?.httpStatusCode === 404) {
                            finalS3Key = testS3Key;
                            finalFileName = testFileName;
                            isCollision = false; 
                        } else {
                            throw s3Error; 
                        }
                    }
                }

                await s3.send(new CopyObjectCommand({
                    Bucket: BUCKET_NAME,
                    CopySource: `${BUCKET_NAME}/${currentS3Key}`,
                    Key: finalS3Key
                }));

                await s3.send(new DeleteObjectCommand({ Bucket: BUCKET_NAME, Key: currentS3Key }));
            }

            await dynamo.send(new UpdateItemCommand({
                TableName: TABLE_NAME,
                Key: { "image_id": { S: image_id } },
                UpdateExpression: "SET #ref = :r, #vxt = :v, #fnm = :f, #s3k = :k, #bv = :b",
                ExpressionAttributeNames: {
                    "#ref": "reference",
                    "#vxt": "verse_text",
                    "#fnm": "current_filename",
                    "#s3k": "s3_key",
                    "#bv": "bible_version"
                },
                ExpressionAttributeValues: {
                    ":r": { S: reference || "" },
                    ":v": { S: verse_text || "" },
                    ":f": { S: finalFileName || currentFileName },
                    ":k": { S: finalS3Key },
                    ":b": { S: bible_version || "" }
                }
            }));

            try {
                const topicArn = process.env.SNS_TOPIC_ARN;
                if (topicArn) {
                    const alertMessage = [
                        "⚠️ VERSTANTLY SYSTEM UPDATE NOTICE",
                        "========================================",
                        `Asset Identifier : ${image_id}`,
                        `Assigned Reference : ${reference || "None Provided"}`,
                        `Bible Version      : ${bible_version || "None Provided"}`,
                        `Updated S3 Location: s3://${BUCKET_NAME}/${finalS3Key}`,
                        "----------------------------------------",
                        "Scripture Content Preview:",
                        `"${verse_text || "No descriptive body saved."}"`,
                        "========================================",
                        "Automated alert dispatched via AWS administrative pipeline execution."
                    ].join("\n");

                    await sns.send(new PublishCommand({
                        TopicArn: topicArn,
                        Subject: `[Verstantly Alert] Asset Modified - ${reference || image_id}`,
                        Message: alertMessage
                    }));
                }
            } catch (snsErr) {
                console.error("SNS dispatch exception:", snsErr.message);
            }

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({
                    success: true,
                    data: { image_id, s3_key: finalS3Key, current_filename: finalFileName || currentFileName, reference, verse_text, bible_version }
                })
            };
        }

        // ==========================================
        // ROUTE 3: INCREMENT IMAGE VIEW COUNT
        // ==========================================
        if (httpMethod === "POST" && path.includes("/images/view")) {
            const body = JSON.parse(event.body || "{}");
            const { image_id } = body;

            if (!image_id) {
                return {
                    statusCode: 400,
                    headers: { "Content-Type": "application/json", ...corsHeaders },
                    body: JSON.stringify({ success: false, message: "Missing image_id." })
                };
            }

            await dynamo.send(new UpdateItemCommand({
                TableName: TABLE_NAME,
                Key: { "image_id": { S: image_id } },
                UpdateExpression: "ADD #v :inc",
                ExpressionAttributeNames: { "#v": "views" },
                ExpressionAttributeValues: { ":inc": { N: "1" } }
            }));

            return {
                statusCode: 200,
                headers: { "Content-Type": "application/json", ...corsHeaders },
                body: JSON.stringify({ success: true, message: "View count incremented safely." })
            };
        }

        return {
            statusCode: 404,
            headers: { "Content-Type": "application/json", ...corsHeaders },
            body: JSON.stringify({ message: `Route path [${httpMethod} ${path}] not matched.` })
        };

    } catch (error) {
        console.error("Fatal exception parsed:", error);
        return {
            statusCode: 500, 
            headers: { "Content-Type": "application/json", ...corsHeaders },
            body: JSON.stringify({ success: false, error: error.message })
        };
    }
};
